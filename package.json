{
  "name": "battle-isle-3-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Browser reimplementation of Battle Isle 3 - Schatten des Imperators (requires original CD data)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import-cd": "node tools/import-cd.ts",
    "inventory": "node tools/inventory.ts",
    "test:e2e": "playwright test",
    "campaign-run": "node tools/campaign-run.ts",
    "validation-doc": "node tools/validation-doc.ts",
    "dist": "node tools/build-dist.ts",
    "dist:docker": "node tools/build-dist.ts --target docker",
    "dist:portable": "node tools/build-dist.ts --target portable --zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
